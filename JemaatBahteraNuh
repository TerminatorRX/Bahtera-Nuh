
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Informasi Jemaat & Keuangan - Jemaat Bahtera Nuh</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Chart.js for beautiful reporting -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Google Fonts (Inter) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        /* Custom scrollbar for desktop */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 flex flex-col min-h-screen">

    <!-- Mobile Navigation Bar (Header) -->
    <header class="bg-emerald-800 text-white shadow-md px-4 py-3 sticky top-0 z-40 flex justify-between items-center lg:px-8">
        <div class="flex items-center space-x-3">
            <div class="bg-white p-1.5 rounded-lg text-emerald-800 shadow">
                <i data-lucide="church" class="w-6 h-6"></i>
            </div>
            <div>
                <h1 class="text-base sm:text-lg font-bold leading-tight">Jemaat Bahtera Nuh</h1>
                <p class="text-xs text-emerald-100">Sistem Informasi Jemaat & Keuangan</p>
            </div>
        </div>
        <!-- Mobile menu button -->
        <button id="mobileMenuBtn" class="lg:hidden p-2 hover:bg-emerald-700 rounded-lg transition-colors">
            <i data-lucide="menu" class="w-6 h-6"></i>
        </button>
    </header>

    <div class="flex-1 flex flex-col lg:flex-row relative">
        <!-- Sidebar Navigation -->
        <aside id="sidebar" class="bg-white w-64 border-r border-slate-200 flex-col justify-between absolute inset-y-0 left-0 transform -translate-x-full lg:relative lg:translate-x-0 transition-transform duration-300 ease-in-out z-30 flex h-full min-h-[calc(100vh-60px)]">
            <div class="p-4 flex-1">
                <nav class="space-y-1">
                    <button onclick="switchTab('dashboard')" id="nav-dashboard" class="w-full flex items-center space-x-3 px-4 py-3 text-sm font-medium rounded-lg transition-colors text-emerald-800 bg-emerald-50">
                        <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
                        <span>Dashboard</span>
                    </button>
                    <button onclick="switchTab('jemaat')" id="nav-jemaat" class="w-full flex items-center space-x-3 px-4 py-3 text-sm font-medium rounded-lg transition-colors text-slate-600 hover:bg-slate-50">
                        <i data-lucide="users" class="w-5 h-5"></i>
                        <span>Data Jemaat</span>
                    </button>
                    <button onclick="switchTab('keuangan')" id="nav-keuangan" class="w-full flex items-center space-x-3 px-4 py-3 text-sm font-medium rounded-lg transition-colors text-slate-600 hover:bg-slate-50">
                        <i data-lucide="wallet" class="w-5 h-5"></i>
                        <span>Keuangan Kas</span>
                    </button>
                    <button onclick="switchTab('laporan')" id="nav-laporan" class="w-full flex items-center space-x-3 px-4 py-3 text-sm font-medium rounded-lg transition-colors text-slate-600 hover:bg-slate-50">
                        <i data-lucide="trending-up" class="w-5 h-5"></i>
                        <span>Laporan Keuangan</span>
                    </button>
                </nav>
            </div>
            <div class="p-4 border-t border-slate-200">
                <div class="bg-slate-50 p-3 rounded-lg text-xs text-slate-500 text-center">
                    <p class="font-medium text-slate-700">Penyimpanan Aktif</p>
                    <p class="mt-1">Disimpan otomatis di perangkat Anda (Local Storage)</p>
                </div>
            </div>
        </aside>

        <!-- Overlay for Mobile Sidebar -->
        <div id="sidebarOverlay" class="hidden fixed inset-0 bg-black bg-opacity-40 z-20 transition-opacity"></div>

        <!-- Main Content Area -->
        <main class="flex-1 p-4 lg:p-8 overflow-y-auto max-w-7xl mx-auto w-full">
            
            <!-- Toast Notification Container -->
            <div id="toastContainer" class="fixed top-4 right-4 z-50 flex flex-col gap-2"></div>

            <!-- ================= TAB: DASHBOARD ================= -->
            <section id="tab-dashboard" class="tab-content space-y-6">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                    <div>
                        <h2 class="text-2xl font-bold text-slate-800">Selamat Datang di Portal Pengelola</h2>
                        <p class="text-sm text-slate-500">Ringkasan cepat status jemaat dan perkembangan finansial Jemaat Bahtera Nuh.</p>
                    </div>
                </div>

                <!-- Stats Cards Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                    <!-- Card Total Jemaat -->
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-100 flex items-center space-x-4">
                        <div class="p-3 rounded-xl bg-blue-50 text-blue-600">
                            <i data-lucide="users" class="w-7 h-7"></i>
                        </div>
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Jemaat</p>
                            <h3 id="statTotalJemaat" class="text-2xl font-bold text-slate-800">0</h3>
                            <p class="text-xs text-slate-500 mt-0.5">Jiwa Terdaftar</p>
                        </div>
                    </div>
                    <!-- Card Saldo Kas -->
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-100 flex items-center space-x-4">
                        <div class="p-3 rounded-xl bg-emerald-50 text-emerald-600">
                            <i data-lucide="wallet" class="w-7 h-7"></i>
                        </div>
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Saldo Kas Aktif</p>
                            <h3 id="statSaldoKas" class="text-2xl font-bold text-slate-800">Rp 0</h3>
                            <p class="text-xs text-slate-500 mt-0.5">Total Saldo Bersih</p>
                        </div>
                    </div>
                    <!-- Card Total Pemasukan -->
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-100 flex items-center space-x-4">
                        <div class="p-3 rounded-xl bg-teal-50 text-teal-600">
                            <i data-lucide="arrow-down-left" class="w-7 h-7"></i>
                        </div>
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Pemasukan</p>
                            <h3 id="statTotalPemasukan" class="text-2xl font-bold text-slate-800 text-teal-600">Rp 0</h3>
                            <p class="text-xs text-slate-500 mt-0.5">Seluruh Transaksi</p>
                        </div>
                    </div>
                    <!-- Card Total Pengeluaran -->
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-100 flex items-center space-x-4">
                        <div class="p-3 rounded-xl bg-rose-50 text-rose-600">
                            <i data-lucide="arrow-up-right" class="w-7 h-7"></i>
                        </div>
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Pengeluaran</p>
                            <h3 id="statTotalPengeluaran" class="text-2xl font-bold text-slate-800 text-rose-600">Rp 0</h3>
                            <p class="text-xs text-slate-500 mt-0.5">Seluruh Transaksi</p>
                        </div>
                    </div>
                </div>

                <!-- Dashboard Content Layout -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Chart Section -->
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-100 lg:col-span-2">
                        <div class="flex items-center justify-between mb-4">
                            <h4 class="text-base font-bold text-slate-800">Visualisasi Keuangan</h4>
                            <span class="text-xs text-slate-500">Pemasukan vs Pengeluaran</span>
                        </div>
                        <div class="h-64 relative">
                            <canvas id="financialChart"></canvas>
                        </div>
                    </div>
                    
                    <!-- Quick Stats Jemaat Berdasarkan Kategori -->
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-100 flex flex-col justify-between">
                        <div>
                            <h4 class="text-base font-bold text-slate-800 mb-4">Statistik Keanggotaan</h4>
                            <div class="space-y-4">
                                <div>
                                    <div class="flex justify-between text-xs font-medium mb-1">
                                        <span class="text-slate-600">Jemaat Dewasa & Lansia</span>
                                        <span id="statJemaatDewasa" class="text-slate-900 font-bold">0</span>
                                    </div>
                                    <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
                                        <div id="barJemaatDewasa" class="bg-blue-500 h-full transition-all" style="width: 0%"></div>
                                    </div>
                                </div>
                                <div>
                                    <div class="flex justify-between text-xs font-medium mb-1">
                                        <span class="text-slate-600">Anak-Anak & Remaja</span>
                                        <span id="statJemaatAnak" class="text-slate-900 font-bold">0</span>
                                    </div>
                                    <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
                                        <div id="barJemaatAnak" class="bg-purple-500 h-full transition-all" style="width: 0%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-6 pt-4 border-t border-slate-100">
                            <button onclick="switchTab('jemaat')" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-2.5 px-4 rounded-xl text-sm transition-colors flex items-center justify-center space-x-2">
                                <span>Kelola Jemaat</span>
                                <i data-lucide="arrow-right" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ================= TAB: DATA JEMAAT ================= -->
            <section id="tab-jemaat" class="tab-content hidden space-y-6">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                    <div>
                        <h2 class="text-2xl font-bold text-slate-800">Database Keanggotaan Jemaat</h2>
                        <p class="text-sm text-slate-500">Kelola informasi jemaat dengan mudah: tambah, sunting, cari, dan hapus.</p>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <button onclick="exportJemaatCSV()" class="bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 font-semibold py-2 px-4 rounded-xl text-sm transition-colors flex items-center space-x-2">
                            <i data-lucide="download" class="w-4 h-4"></i>
                            <span class="hidden sm:inline">Ekspor CSV</span>
                        </button>
                        <button onclick="openJemaatModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2 px-4 rounded-xl text-sm transition-colors flex items-center space-x-2 shadow-sm">
                            <i data-lucide="plus" class="w-4 h-4"></i>
                            <span>Tambah Jemaat</span>
                        </button>
                    </div>
                </div>

                <!-- Search & Filters -->
                <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-100 flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div class="relative flex-1 max-w-md">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                            <i data-lucide="search" class="w-5 h-5"></i>
                        </span>
                        <input type="text" id="jemaatSearch" oninput="filterJemaat()" placeholder="Cari nama jemaat atau alamat..." class="w-full pl-10 pr-4 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500 text-sm">
                    </div>
                    <div class="flex items-center space-x-3 w-full md:w-auto">
                        <select id="jemaatFilterSektor" onchange="filterJemaat()" class="flex-1 md:flex-initial bg-slate-50 border border-slate-200 rounded-xl py-2 px-4 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            <option value="">Semua Wilayah/Sektor</option>
                            <option value="Sektor 1">Sektor 1</option>
                            <option value="Sektor 2">Sektor 2</option>
                            <option value="Sektor 3">Sektor 3</option>
                            <option value="Sektor 4">Sektor 4</option>
                        </select>
                        <select id="jemaatFilterKategori" onchange="filterJemaat()" class="flex-1 md:flex-initial bg-slate-50 border border-slate-200 rounded-xl py-2 px-4 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            <option value="">Semua Kategori Umur</option>
                            <option value="Dewasa">Dewasa/Lansia</option>
                            <option value="Anak">Anak-Anak/Remaja</option>
                        </select>
                    </div>
                </div>

                <!-- Jemaat Table -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
                    <div class="hidden md:block overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 text-xs font-semibold uppercase tracking-wider border-b border-slate-100">
                                    <th class="py-4 px-6">Nama Lengkap</th>
                                    <th class="py-4 px-6">Sektor</th>
                                    <th class="py-4 px-6">No. Telepon</th>
                                    <th class="py-4 px-6">Alamat</th>
                                    <th class="py-4 px-6">Kategori</th>
                                    <th class="py-4 px-6 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="jemaatTableBody" class="divide-y divide-slate-100 text-sm text-slate-700">
                                <!-- Render via JS -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Mobile View -->
                    <div class="md:hidden p-4 space-y-4" id="jemaatCardsContainer">
                        <!-- Render via JS -->
                    </div>

                    <div id="jemaatEmptyState" class="hidden py-12 text-center text-slate-400">
                        <i data-lucide="folder-open" class="w-12 h-12 mx-auto stroke-1 mb-3"></i>
                        <p class="text-sm">Tidak ada data jemaat yang cocok.</p>
                    </div>
                </div>
            </section>

            <!-- ================= TAB: KEUANGAN ================= -->
            <section id="tab-keuangan" class="tab-content hidden space-y-6">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                    <div>
                        <h2 class="text-2xl font-bold text-slate-800">Manajemen Kas Jemaat Bahtera Nuh</h2>
                        <p class="text-sm text-slate-500">Catat setiap pemasukan dan pengeluaran gereja dengan transparan.</p>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <button onclick="exportKeuanganCSV()" class="bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 font-semibold py-2 px-4 rounded-xl text-sm transition-colors flex items-center space-x-2">
                            <i data-lucide="download" class="w-4 h-4"></i>
                            <span class="hidden sm:inline">Ekspor CSV</span>
                        </button>
                        <button onclick="openKeuanganModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2 px-4 rounded-xl text-sm transition-colors flex items-center space-x-2 shadow-sm">
                            <i data-lucide="plus" class="w-4 h-4"></i>
                            <span>Tambah Transaksi</span>
                        </button>
                    </div>
                </div>

                <!-- Financial Quick Stats -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100 flex items-center justify-between">
                        <div>
                            <p class="text-xs text-slate-400 font-semibold">Total Pemasukan</p>
                            <h4 id="tabStatPemasukan" class="text-lg font-bold text-teal-600">Rp 0</h4>
                        </div>
                        <div class="p-2 bg-teal-50 rounded-lg text-teal-600">
                            <i data-lucide="arrow-down-left" class="w-5 h-5"></i>
                        </div>
                    </div>
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100 flex items-center justify-between">
                        <div>
                            <p class="text-xs text-slate-400 font-semibold">Total Pengeluaran</p>
                            <h4 id="tabStatPengeluaran" class="text-lg font-bold text-rose-600">Rp 0</h4>
                        </div>
                        <div class="p-2 bg-rose-50 rounded-lg text-rose-600">
                            <i data-lucide="arrow-up-right" class="w-5 h-5"></i>
                        </div>
                    </div>
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100 flex items-center justify-between">
                        <div>
                            <p class="text-xs text-slate-400 font-semibold">Saldo Kas</p>
                            <h4 id="tabStatSaldo" class="text-lg font-bold text-slate-800">Rp 0</h4>
                        </div>
                        <div class="p-2 bg-slate-50 rounded-lg text-slate-600">
                            <i data-lucide="wallet" class="w-5 h-5"></i>
                        </div>
                    </div>
                </div>

                <!-- Keuangan Table -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
                    <div class="p-4 border-b border-slate-100 flex flex-col md:flex-row md:items-center justify-between gap-4">
                        <h3 class="text-base font-bold text-slate-800">Riwayat Mutasi Kas</h3>
                        <div class="flex items-center space-x-2">
                            <select id="keuanganFilterJenis" onchange="filterKeuangan()" class="bg-slate-50 border border-slate-200 rounded-xl py-2 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                                <option value="">Semua Jenis</option>
                                <option value="Pemasukan">Pemasukan</option>
                                <option value="Pengeluaran">Pengeluaran</option>
                            </select>
                            <select id="keuanganFilterKategori" onchange="filterKeuangan()" class="bg-slate-50 border border-slate-200 rounded-xl py-2 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                                <option value="">Semua Kategori</option>
                                <option value="Kolekte">Kolekte Mingguan</option>
                                <option value="Persepuluhan">Persepuluhan</option>
                                <option value="Sumbangan">Sumbangan/Donasi</option>
                                <option value="Operasional">Operasional Gereja</option>
                                <option value="Pembangunan">Pembangunan</option>
                                <option value="Lainnya">Lainnya</option>
                            </select>
                        </div>
                    </div>

                    <!-- Desktop View -->
                    <div class="hidden md:block overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 text-xs font-semibold uppercase tracking-wider border-b border-slate-100">
                                    <th class="py-4 px-6">Tanggal</th>
                                    <th class="py-4 px-6">Kategori</th>
                                    <th class="py-4 px-6">Keterangan</th>
                                    <th class="py-4 px-6">Jenis</th>
                                    <th class="py-4 px-6 text-right">Jumlah</th>
                                    <th class="py-4 px-6 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="keuanganTableBody" class="divide-y divide-slate-100 text-sm text-slate-700">
                                <!-- Render via JS -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Mobile View -->
                    <div class="md:hidden p-4 space-y-4" id="keuanganCardsContainer">
                        <!-- Render via JS -->
                    </div>

                    <div id="keuanganEmptyState" class="hidden py-12 text-center text-slate-400">
                        <i data-lucide="folder-open" class="w-12 h-12 mx-auto stroke-1 mb-3"></i>
                        <p class="text-sm">Tidak ada transaksi yang cocok.</p>
                    </div>
                </div>
            </section>

            <!-- ================= TAB: LAPORAN KEUANGAN ================= -->
            <section id="tab-laporan" class="tab-content hidden space-y-6">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                    <div>
                        <h2 class="text-2xl font-bold text-slate-800">Laporan & Analitik Keuangan</h2>
                        <p class="text-sm text-slate-500">Analisis visual mendalam terkait pembukuan finansial jemaat dan kas Jemaat Bahtera Nuh.</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <!-- Chart Keuangan Bulanan -->
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-100">
                        <h3 class="text-base font-bold text-slate-800 mb-4">Tren Pemasukan vs Pengeluaran</h3>
                        <div class="h-80 relative">
                            <canvas id="laporanTrendChart"></canvas>
                        </div>
                    </div>

                    <!-- Distribusi Kategori Pemasukan -->
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-100">
                        <h3 class="text-base font-bold text-slate-800 mb-4">Proporsi Pemasukan Berdasarkan Kategori</h3>
                        <div class="h-80 relative flex justify-center">
                            <canvas id="laporanPiePemasukan"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Ringkasan Singkat Sederhana -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
                    <h3 class="text-base font-bold text-slate-800 mb-4">Ringkasan Evaluasi Saldo Bersih</h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm">
                        <div class="space-y-2">
                            <span class="text-slate-400 font-medium">Persentase Efisiensi</span>
                            <div class="flex items-center space-x-2">
                                <span id="laporanPersenEfisiensi" class="text-xl font-bold text-teal-600">0%</span>
                                <span class="text-slate-500">(Sisa Saldo dari Pemasukan)</span>
                            </div>
                        </div>
                        <div class="space-y-2">
                            <span class="text-slate-400 font-medium">Transaksi Terakhir</span>
                            <div id="laporanTransaksiTerakhir" class="text-slate-700 font-medium">
                                Tidak ada transaksi terbaru
                            </div>
                        </div>
                        <div class="space-y-2">
                            <span class="text-slate-400 font-medium">Status Kesehatan Kas</span>
                            <div class="flex items-center space-x-2">
                                <span id="laporanStatusKas" class="px-2.5 py-1 text-xs font-bold rounded-full bg-emerald-50 text-emerald-700">Sehat</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

        </main>
    </div>

    <!-- ================= MODAL: TAMBAH/EDIT JEMAAT ================= -->
    <div id="jemaatModal" class="hidden fixed inset-0 bg-slate-900 bg-opacity-50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-lg w-full overflow-hidden shadow-xl transform transition-all duration-300">
            <div class="bg-slate-50 px-6 py-4 border-b border-slate-150 flex items-center justify-between">
                <h3 id="jemaatModalTitle" class="text-lg font-bold text-slate-800">Tambah Data Jemaat</h3>
                <button onclick="closeJemaatModal()" class="text-slate-400 hover:text-slate-600">
