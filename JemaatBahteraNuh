    <!-- ================= MODAL KONFIRMASI HAPUS (KUSTOM) ================= -->
    <div id="deleteConfirmModal" class="hidden fixed inset-0 bg-slate-900 bg-opacity-60 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-sm w-full overflow-hidden shadow-2xl transform transition-all duration-300 p-6 space-y-4">
            <div class="flex items-center space-x-3 text-rose-600">
                <i data-lucide="alert-triangle" class="w-8 h-8"></i>
                <h3 class="text-lg font-bold text-slate-800">Konfirmasi Hapus</h3>
            </div>
            <p id="deleteConfirmMessage" class="text-sm text-slate-600">Apakah Anda yakin ingin menghapus data ini secara permanen?</p>
            <div class="flex justify-end space-x-2 pt-2">
                <button onclick="closeDeleteModal()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-2 px-4 rounded-xl text-sm transition-colors">Batal</button>
                <button id="confirmDeleteBtn" class="bg-rose-600 hover:bg-rose-700 text-white font-semibold py-2 px-4 rounded-xl text-sm transition-colors shadow-sm">Hapus Sekarang</button>
            </div>
        </div>
    </div>

    <!-- ================= SCRIPT INDEPENDENT ================= -->
    <script>
        // Data Awal Mock
        const initialJemaat = [
            { id: "1", nama: "Yohanes Sitorus", sektor: "Sektor 1", telepon: "081290348761", alamat: "Jl. Merdeka No. 45", kategori: "Dewasa" },
            { id: "2", nama: "Maria Sondakh", sektor: "Sektor 2", telepon: "081374628190", alamat: "Perum Indah Lestari Blok C-10", kategori: "Dewasa" },
            { id: "3", nama: "Andreas Prasetyo", sektor: "Sektor 3", telepon: "081198302111", alamat: "Jl. Mawar Gg. 3 No. 12", kategori: "Dewasa" },
            { id: "4", nama: "Grace Natalia", sektor: "Sektor 1", telepon: "082133445566", alamat: "Komp. Asri Gg. Cemara 5", kategori: "Anak" },
            { id: "5", nama: "Samuel Marbun", sektor: "Sektor 4", telepon: "085277881122", alamat: "Samping Balai Desa, RT 02", kategori: "Anak" }
        ];

        const initialKeuangan = [
            { id: "101", tanggal: "2026-05-10", kategori: "Kolekte", keterangan: "Kolekte Ibadah Minggu Pagi", jenis: "Pemasukan", jumlah: 2450000 },
            { id: "102", tanggal: "2026-05-10", kategori: "Persepuluhan", keterangan: "Persepuluhan Keluarga Bpk. Yohanes", jenis: "Pemasukan", jumlah: 1500000 },
            { id: "103", tanggal: "2026-05-12", kategori: "Operasional", keterangan: "Pembayaran tagihan listrik & air gereja", jenis: "Pengeluaran", jumlah: 850000 },
            { id: "104", tanggal: "2026-05-15", kategori: "Sumbangan", keterangan: "Sumbangan dari Hamba Tuhan untuk pembangunan", jenis: "Pemasukan", jumlah: 5000000 },
            { id: "105", tanggal: "2026-05-18", kategori: "Operasional", keterangan: "Belanja konsumsi rapat pengurus gereja", jenis: "Pengeluaran", jumlah: 350000 },
            { id: "106", tanggal: "2026-05-22", kategori: "Pembangunan", keterangan: "Pembelian semen dan pasir renovasi pagar", jenis: "Pengeluaran", jumlah: 1200000 }
        ];

        let jemaatList = JSON.parse(localStorage.getItem('gereja_jemaat')) || initialJemaat;
        let keuanganList = JSON.parse(localStorage.getItem('gereja_keuangan')) || initialKeuangan;
        let chartsInstance = {};
        let deleteCallback = null;

        function saveData() {
            localStorage.setItem('gereja_jemaat', JSON.stringify(jemaatList));
            localStorage.setItem('gereja_keuangan', JSON.stringify(keuanganList));
            updateAllViews();
        }

        window.onload = function() {
            lucide.createIcons();
            document.getElementById('keuanganTanggal').value = new Date().toISOString().split('T')[0];
            updateKategoriOptions();
            updateAllViews();
            initCharts();

            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');

            mobileMenuBtn.onclick = () => {
                sidebar.classList.toggle('-translate-x-full');
                overlay.classList.toggle('hidden');
            };

            overlay.onclick = () => {
                sidebar.classList.add('-translate-x-full');
                overlay.classList.add('hidden');
            };
        };

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.add('hidden'));
            document.getElementById(`tab-${tabId}`).classList.remove('hidden');

            document.querySelectorAll('aside nav button').forEach(btn => {
                btn.className = "w-full flex items-center space-x-3 px-4 py-3 text-sm font-medium rounded-lg transition-colors text-slate-600 hover:bg-slate-50";
            });

            const activeBtn = document.getElementById(`nav-${tabId}`);
            if (activeBtn) {
                activeBtn.className = "w-full flex items-center space-x-3 px-4 py-3 text-sm font-medium rounded-lg transition-colors text-emerald-700 bg-emerald-50";
            }

            document.getElementById('sidebar').classList.add('-translate-x-full');
            document.getElementById('sidebarOverlay').classList.add('hidden');

            if (tabId === 'dashboard' || tabId === 'laporan') {
                setTimeout(updateCharts, 100);
            }
        }

        function formatRupiah(number) {
            return new Intl.NumberFormat('id-ID', {
                style: 'currency',
                currency: 'IDR',
                minimumFractionDigits: 0,
                maximumFractionDigits: 0
            }).format(number);
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            let bgClass = type === 'success' ? 'bg-emerald-600' : 'bg-rose-600';
            let icon = type === 'success' ? 'check-circle' : 'alert-triangle';
            
            toast.className = `flex items-center space-x-3 text-white px-4 py-3 rounded-xl shadow-lg transition-all duration-300 transform translate-y-2 opacity-0 ${bgClass}`;
            toast.innerHTML = `<i data-lucide="${icon}" class="w-5 h-5"></i><span class="text-sm font-medium">${message}</span>`;
            
            container.appendChild(toast);
            lucide.createIcons();

            setTimeout(() => toast.classList.remove('translate-y-2', 'opacity-0'), 10);
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        function openDeleteModal(message, callback) {
            const modal = document.getElementById('deleteConfirmModal');
            document.getElementById('deleteConfirmMessage').innerText = message;
            deleteCallback = callback;
            modal.classList.remove('hidden');
            
            document.getElementById('confirmDeleteBtn').onclick = function() {
                if (deleteCallback) deleteCallback();
                closeDeleteModal();
            };
        }

        function closeDeleteModal() {
            document.getElementById('deleteConfirmModal').classList.add('hidden');
            deleteCallback = null;
        }

        function updateAllViews() {
            updateDashboardStats();
            filterJemaat();
            filterKeuangan();
            updateCharts();
        }

        function updateDashboardStats() {
            const totalJemaat = jemaatList.length;
            document.getElementById('statTotalJemaat').innerText = totalJemaat;

            const dewasas = jemaatList.filter(j => j.kategori === 'Dewasa').length;
            const anaks = jemaatList.filter(j => j.kategori === 'Anak').length;

            document.getElementById('statJemaatDewasa').innerText = dewasas;
            document.getElementById('statJemaatAnak').innerText = anaks;

            const barDewasa = totalJemaat > 0 ? (dewasas / totalJemaat) * 100 : 0;
            const barAnak = totalJemaat > 0 ? (anaks / totalJemaat) * 100 : 0;

            document.getElementById('barJemaatDewasa').style.width = `${barDewasa}%`;
            document.getElementById('barJemaatAnak').style.width = `${barAnak}%`;

            let totalMasuk = 0;
            let totalKeluar = 0;

            keuanganList.forEach(t => {
                if (t.jenis === 'Pemasukan') totalMasuk += Number(t.jumlah);
                else totalKeluar += Number(t.jumlah);
            });

            const saldo = totalMasuk - totalKeluar;

            document.getElementById('statSaldoKas').innerText = formatRupiah(saldo);
            document.getElementById('statTotalPemasukan').innerText = formatRupiah(totalMasuk);
            document.getElementById('statTotalPengeluaran').innerText = formatRupiah(totalKeluar);

            document.getElementById('tabStatPemasukan').innerText = formatRupiah(totalMasuk);
            document.getElementById('tabStatPengeluaran').innerText = formatRupiah(totalKeluar);
            document.getElementById('tabStatSaldo').innerText = formatRupiah(saldo);

            const efisiensi = totalMasuk > 0 ? Math.round((saldo / totalMasuk) * 100) : 0;
            document.getElementById('laporanPersenEfisiensi').innerText = `${efisiensi}%`;
            
            const lastTrx = keuanganList[0];
            if (lastTrx) {
                document.getElementById('laporanTransaksiTerakhir').innerHTML = `
                    <p class="font-semibold text-slate-800">${lastTrx.keterangan}</p>
                    <p class="text-xs text-slate-400">${lastTrx.tanggal} • <span class="${lastTrx.jenis === 'Pemasukan' ? 'text-teal-600' : 'text-rose-600'}">${lastTrx.jenis}</span></p>
                `;
            }

            const statusKasEl = document.getElementById('laporanStatusKas');
            if (saldo < 0) {
                statusKasEl.className = "px-2.5 py-1 text-xs font-bold rounded-full bg-rose-50 text-rose-700";
                statusKasEl.innerText = "Defisit";
            } else {
                statusKasEl.className = "px-2.5 py-1 text-xs font-bold rounded-full bg-emerald-50 text-emerald-700";
                statusKasEl.innerText = "Sehat";
            }
        }

        // ================= JEMAAT ACTIONS =================
        function openJemaatModal(id = null) {
            const modal = document.getElementById('jemaatModal');
            const title = document.getElementById('jemaatModalTitle');
            const form = document.getElementById('jemaatForm');
            form.reset();

            if (id) {
                title.innerText = "Edit Data Jemaat";
                const jemaat = jemaatList.find(j => j.id === id);
                if (jemaat) {
                    document.getElementById('jemaatId').value = jemaat.id;
                    document.getElementById('jemaatNama').value = jemaat.nama;
                    document.getElementById('jemaatSektor').value = jemaat.sektor;
                    document.getElementById('jemaatTelepon').value = jemaat.telepon;
                    document.getElementById('jemaatAlamat').value = jemaat.alamat;
                    document.querySelector(`input[name="jemaatKategori"][value="${jemaat.kategori}"]`).checked = true;
                }
            } else {
                title.innerText = "Tambah Jemaat Baru";
                document.getElementById('jemaatId').value = "";
            }
            modal.classList.remove('hidden');
        }

        function closeJemaatModal() {
            document.getElementById('jemaatModal').classList.add('hidden');
        }

        function saveJemaat(e) {
            e.preventDefault();
            const id = document.getElementById('jemaatId').value;
            const nama = document.getElementById('jemaatNama').value;
            const sektor = document.getElementById('jemaatSektor').value;
            const telepon = document.getElementById('jemaatTelepon').value || '-';
            const alamat = document.getElementById('jemaatAlamat').value;
            const kategori = document.querySelector('input[name="jemaatKategori"]:checked').value;

            if (id) {
                const index = jemaatList.findIndex(j => j.id === id);
                if (index !== -1) {
                    jemaatList[index] = { id, nama, sektor, telepon, alamat, kategori };
                    showToast("Data jemaat diperbarui", "success");
                }
            } else {
                const newId = Date.now().toString();
                jemaatList.push({ id: newId, nama, sektor, telepon, alamat, kategori });
                showToast("Jemaat baru ditambahkan", "success");
            }
            saveData();
            closeJemaatModal();
        }

        function deleteJemaat(id) {
            const j = jemaatList.find(x => x.id === id);
            openDeleteModal(`Hapus jemaat "${j ? j.nama : ''}"?`, function() {
                jemaatList = jemaatList.filter(x => x.id !== id);
                showToast("Jemaat berhasil dihapus", "success");
                saveData();
            });
        }

        function filterJemaat() {
            const query = document.getElementById('jemaatSearch').value.toLowerCase();
            const filterSektor = document.getElementById('jemaatFilterSektor').value;
            const filterKategori = document.getElementById('jemaatFilterKategori').value;

            const filtered = jemaatList.filter(j => {
                const matchQuery = j.nama.toLowerCase().includes(query) || j.alamat.toLowerCase().includes(query);
                const matchSektor = filterSektor === "" || j.sektor === filterSektor;
                const matchKategori = filterKategori === "" || j.kategori === filterKategori;
                return matchQuery && matchSektor && matchKategori;
            });
            renderJemaatTable(filtered);
        }

        function renderJemaatTable(data) {
            const tableBody = document.getElementById('jemaatTableBody');
            const cardsContainer = document.getElementById('jemaatCardsContainer');
            const emptyState = document.getElementById('jemaatEmptyState');

            tableBody.innerHTML = "";
            cardsContainer.innerHTML = "";

            if (data.length === 0) {
                emptyState.classList.remove('hidden');
                return;
            }
            emptyState.classList.add('hidden');

            data.forEach(j => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 transition-colors";
                tr.innerHTML = `
                    <td class="py-4 px-6 font-semibold text-slate-800">${j.nama}</td>
                    <td class="py-4 px-6 text-slate-500">${j.sektor}</td>
                    <td class="py-4 px-6 text-slate-500">${j.telepon}</td>
                    <td class="py-4 px-6 text-slate-500 max-w-xs truncate">${j.alamat}</td>
                    <td class="py-4 px-6">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${j.kategori === 'Dewasa' ? 'bg-blue-50 text-blue-700' : 'bg-purple-50 text-purple-700'}">
                            ${j.kategori}
                        </span>
                    </td>
                    <td class="py-4 px-6 text-center space-x-1">
                        <button onclick="openJemaatModal('${j.id}')" class="text-blue-600 p-1.5 hover:bg-blue-50 rounded-lg"><i data-lucide="edit-3" class="w-4 h-4"></i></button>
                        <button onclick="deleteJemaat('${j.id}')" class="text-rose-600 p-1.5 hover:bg-rose-50 rounded-lg"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                    </td>
                `;
                tableBody.appendChild(tr);

                const card = document.createElement('div');
                card.className = "bg-slate-50 p-4 rounded-xl border border-slate-100 space-y-3";
                card.innerHTML = `
                    <div class="flex justify-between items-start">
                        <div>
                            <h4 class="font-bold text-slate-800">${j.nama}</h4>
                            <p class="text-xs text-slate-400">${j.sektor}</p>
                        </div>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${j.kategori === 'Dewasa' ? 'bg-blue-50 text-blue-700' : 'bg-purple-50 text-purple-700'}">${j.kategori}</span>
                    </div>
                    <div class="text-xs text-slate-500 space-y-1">
                        <p><span class="font-medium">Telp:</span> ${j.telepon}</p>
                        <p><span class="font-medium">Alamat:</span> ${j.alamat}</p>
                    </div>
                    <div class="flex items-center justify-end space-x-2 pt-2 border-t border-slate-200">
                        <button onclick="openJemaatModal('${j.id}')" class="bg-blue-50 text-blue-700 py-1.5 px-3 rounded-lg text-xs font-semibold">Edit</button>
                        <button onclick="deleteJemaat('${j.id}')" class="bg-rose-50 text-rose-700 py-1.5 px-3 rounded-lg text-xs font-semibold">Hapus</button>
                    </div>
                `;
                cardsContainer.appendChild(card);
            });
            lucide.createIcons();
        }

        // ================= KEUANGAN ACTIONS =================
        function openKeuanganModal() {
            document.getElementById('keuanganForm').reset();
            document.getElementById('keuanganTanggal').value = new Date().toISOString().split('T')[0];
            updateKategoriOptions();
            document.getElementById('keuanganModal').classList.remove('hidden');
        }

        function closeKeuanganModal() {
            document.getElementById('keuanganModal').classList.add('hidden');
        }

        function updateKategoriOptions() {
            const jenis = document.getElementById('keuanganJenis').value;
            const kategoriSelect = document.getElementById('keuanganKategori');
            kategoriSelect.innerHTML = "";

            const categories = {
                Pemasukan: [
                    { val: "Kolekte", txt: "Kolekte Ibadah" },
                    { val: "Persepuluhan", txt: "Persepuluhan" },
                    { val: "Sumbangan", txt: "Sumbangan & Donasi" },
                    { val: "Lainnya", txt: "Lain-Lain Pemasukan" }
                ],
                Pengeluaran: [
                    { val: "Operasional", txt: "Operasional Gereja" },
                    { val: "Pembangunan", txt: "Pembangunan/Renovasi" },
                    { val: "Sosial", txt: "Bantuan Sosial/Diakonia" },
                    { val: "Lainnya", txt: "Lain-Lain Pengeluaran" }
                ]
            };

            categories[jenis].forEach(cat => {
                const opt = document.createElement('option');
                opt.value = cat.val;
                opt.innerText = cat.txt;
                kategoriSelect.appendChild(opt);
            });
        }

        function saveKeuangan(e) {
            e.preventDefault();
            const jenis = document.getElementById('keuanganJenis').value;
            const tanggal = document.getElementById('keuanganTanggal').value;
            const kategori = document.getElementById('keuanganKategori').value;
            const jumlah = Number(document.getElementById('keuanganJumlah').value);
            const keterangan = document.getElementById('keuanganKeterangan').value;

            const newId = Date.now().toString();
            keuanganList.unshift({ id: newId, tanggal, kategori, keterangan, jenis, jumlah });
            showToast("Transaksi berhasil disimpan", "success");

            saveData();
            closeKeuanganModal();
        }

        function deleteKeuangan(id) {
            const trx = keuanganList.find(t => t.id === id);
            openDeleteModal(`Hapus transaksi "${trx ? trx.keterangan : ''}"?`, function() {
                keuanganList = keuanganList.filter(t => t.id !== id);
                showToast("Transaksi berhasil dihapus", "success");
                saveData();
            });
        }

        function filterKeuangan() {
            const filterJenis = document.getElementById('keuanganFilterJenis').value;
            const filterKategori = document.getElementById('keuanganFilterKategori').value;

            const filtered = keuanganList.filter(t => {
                const matchJenis = filterJenis === "" || t.jenis === filterJenis;
                const matchKategori = filterKategori === "" || t.kategori === filterKategori;
                return matchJenis && matchKategori;
            });
            renderKeuanganTable(filtered);
        }

        function renderKeuanganTable(data) {
            const tableBody = document.getElementById('keuanganTableBody');
            const cardsContainer = document.getElementById('keuanganCardsContainer');
            const emptyState = document.getElementById('keuanganEmptyState');

            tableBody.innerHTML = "";
            cardsContainer.innerHTML = "";

            if (data.length === 0) {
                emptyState.classList.remove('hidden');
                return;
            }
            emptyState.classList.add('hidden');

            data.forEach(t => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 transition-colors";
                tr.innerHTML = `
                    <td class="py-4 px-6 text-slate-500">${t.tanggal}</td>
                    <td class="py-4 px-6 font-medium">${t.kategori}</td>
                    <td class="py-4 px-6 text-slate-500 max-w-xs truncate">${t.keterangan}</td>
                    <td class="py-4 px-6"><span class="px-2 py-0.5 rounded-full text-xs font-semibold ${t.jenis === 'Pemasukan' ? 'bg-teal-50 text-teal-700' : 'bg-rose-50 text-rose-700'}">${t.jenis}</span></td>
                    <td class="py-4 px-6 text-right font-bold ${t.jenis === 'Pemasukan' ? 'text-teal-600' : 'text-rose-600'}">${t.jenis === 'Pemasukan' ? '+' : '-'} ${formatRupiah(t.jumlah)}</td>
                    <td class="py-4 px-6 text-center"><button onclick="deleteKeuangan('${t.id}')" class="text-rose-600 p-1.5 hover:bg-rose-50 rounded-lg"><i data-lucide="trash-2" class="w-4 h-4"></i></button></td>
                `;
                tableBody.appendChild(tr);

                const card = document.createElement('div');
                card.className = "bg-slate-50 p-4 rounded-xl border border-slate-100 space-y-2";
                card.innerHTML = `
                    <div class="flex justify-between">
                        <span class="text-xs text-slate-400">${t.tanggal}</span>
                        <span class="px-2 py-0.5 rounded-full text-xs font-semibold ${t.jenis === 'Pemasukan' ? 'bg-teal-50 text-teal-700' : 'bg-rose-50 text-rose-700'}">${t.kategori}</span>
                    </div>
                    <p class="font-bold text-slate-700 text-sm">${t.keterangan}</p>
                    <div class="flex items-center justify-between pt-2 border-t border-slate-200">
                        <span class="text-base font-bold ${t.jenis === 'Pemasukan' ? 'text-teal-600' : 'text-rose-600'}">${t.jenis === 'Pemasukan' ? '+' : '-'} ${formatRupiah(t.jumlah)}</span>
                        <button onclick="deleteKeuangan('${t.id}')" class="bg-rose-50 text-rose-700 p-1.5 rounded-lg text-xs font-semibold">Hapus</button>
                    </div>
                `;
                cardsContainer.appendChild(card);
            });
            lucide.createIcons();
        }

        // ================= CHARTS =================
        function initCharts() {
            const ctx1 = document.getElementById('financialChart').getContext('2d');
            chartsInstance.dashboardChart = new Chart(ctx1, {
                type: 'bar',
                data: {
                    labels: ['Pemasukan', 'Pengeluaran'],
                    datasets: [{
                        data: [0, 0],
                        backgroundColor: ['#0d9488', '#e11d48'],
                        borderRadius: 8
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
            });

            const ctx2 = document.getElementById('laporanTrendChart').getContext('2d');
            chartsInstance.trendChart = new Chart(ctx2, {
                type: 'line',
                data: {
                    labels: [],
                    datasets: [
                        { label: 'Pemasukan', data: [], borderColor: '#0d9488', fill: false },
                        { label: 'Pengeluaran', data: [], borderColor: '#e11d48', fill: false }
                    ]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });

            const ctx3 = document.getElementById('laporanPiePemasukan').getContext('2d');
            chartsInstance.pieChart = new Chart(ctx3, {
                type: 'doughnut',
                data: {
                    labels: ['Kolekte', 'Persepuluhan', 'Sumbangan', 'Lainnya'],
                    datasets: [{ data: [0, 0, 0, 0], backgroundColor: ['#0ea5e9', '#10b981', '#f59e0b', '#64748b'] }]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });
        }

        function updateCharts() {
            if (!chartsInstance.dashboardChart) return;

            let totalMasuk = 0;
            let totalKeluar = 0;
            let catMasuk = { Kolekte: 0, Persepuluhan: 0, Sumbangan: 0, Lainnya: 0 };

            const sortedTimeline = [...keuanganList].sort((a,b) => new Date(a.tanggal) - new Date(b.tanggal));
            const lastDates = Array.from(new Set(sortedTimeline.map(t => t.tanggal))).slice(-5);
            
            const timelineMasuk = lastDates.map(date => sortedTimeline.filter(t => t.tanggal === date && t.jenis === 'Pemasukan').reduce((acc, curr) => acc + curr.jumlah, 0));
            const timelineKeluar = lastDates.map(date => sortedTimeline.filter(t => t.tanggal === date && t.jenis === 'Pengeluaran').reduce((acc, curr) => acc + curr.jumlah, 0));

            keuanganList.forEach(t => {
                if (t.jenis === 'Pemasukan') {
                    totalMasuk += t.jumlah;
                    if (catMasuk[t.kategori] !== undefined) catMasuk[t.kategori] += t.jumlah;
                    else catMasuk['Lainnya'] += t.jumlah;
                } else {
                    totalKeluar += t.jumlah;
                }
            });

            chartsInstance.dashboardChart.data.datasets[0].data = [totalMasuk, totalKeluar];
            chartsInstance.dashboardChart.update();

            chartsInstance.trendChart.data.labels = lastDates;
            chartsInstance.trendChart.data.datasets[0].data = timelineMasuk;
            chartsInstance.trendChart.data.datasets[1].data = timelineKeluar;
            chartsInstance.trendChart.update();

            chartsInstance.pieChart.data.datasets[0].data = [catMasuk.Kolekte, catMasuk.Persepuluhan, catMasuk.Sumbangan, catMasuk.Lainnya];
            chartsInstance.pieChart.update();
        }

        function exportJemaatCSV() {
            let csv = "data:text/csv;charset=utf-8,ID,Nama,Sektor,Telepon,Alamat,Kategori\n";
            jemaatList.forEach(j => csv += `"${j.id}","${j.nama}","${j.sektor}","${j.telepon}","${j.alamat}","${j.kategori}"\n`);
            triggerDownload(csv, "data_jemaat.csv");
        }

        function exportKeuanganCSV() {
            let csv = "data:text/csv;charset=utf-8,ID,Tanggal,Kategori,Keterangan,Jenis,Jumlah\n";
            keuanganList.forEach(t => csv += `"${t.id}","${t.tanggal}","${t.kategori}","${t.keterangan}","${t.jenis}","${t.jumlah}"\n`);
            triggerDownload(csv, "laporan_keuangan.csv");
        }

        function triggerDownload(content, filename) {
            const encodedUri = encodeURI(content);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", filename);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
</body>
